# CYBER dashboard — copy to .env.local for local development.
# Placeholders only. Never commit real values. Only NEXT_PUBLIC_* variables reach the browser.

# --- Discord OAuth2 sign-in (required for login) -----------------------------
# Discord Developer Portal → your application → OAuth2.
# Application ID: a 17–20 digit number. NOT your Discord Server (guild) ID.
DISCORD_CLIENT_ID=000000000000000000
# OAuth2 → Client Secret → Reset Secret. A random string, NOT a number.
DISCORD_CLIENT_SECRET=replace-with-client-secret
# Must exactly match a redirect in Developer Portal → OAuth2 → Redirects.
# Production: https://cyber-eta-ruby.vercel.app/api/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
# Encrypts the session cookie. 32+ random characters (see README / setup guide).
SESSION_SECRET=replace-with-at-least-32-random-characters

# --- Optional ----------------------------------------------------------------
# Server-only. Lets the dashboard show which of your servers already have the bot.
DISCORD_BOT_TOKEN=
# Permission bitfield for the bot invite link. Default excludes Administrator.
DISCORD_BOT_PERMISSIONS=1099780189206
# Base URL of the CYBER backend API. Unset = demo mode (drafts stay in the browser).
NEXT_PUBLIC_CYBER_API_URL=
# Canonical site URL for Open Graph metadata. Falls back to the Vercel production URL.
NEXT_PUBLIC_SITE_URL=
